# Copy this file to .env and fill in values before running locally.
# Never commit .env to git.

# ── Core ──────────────────────────────────────────────────────────────────────
# Required in production — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to 'production' on Render; omit or set 'development' locally.
APP_CONFIG=development

# Render sets this automatically when you attach a PostgreSQL database.
# Leave blank to use SQLite locally.
DATABASE_URL=

# ── Email (Flask-Mail) ────────────────────────────────────────────────────────
# In development, MAIL_SUPPRESS_SEND=True so emails are NOT sent — the
# verification link is printed to the Flask console instead.
# Fill these in only for production (or if you want real email locally).

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=Quiz App <your-email@gmail.com>
